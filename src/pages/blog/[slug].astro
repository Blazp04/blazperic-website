---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../_BlogPost";
import PrecachePost from "../../components/blog/PrecachePost.astro";
import { BLOG_POSTS } from "../../data/blogPosts";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const canonical = new URL(`/blog/${post.slug}`, Astro.site);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  author: { '@type': 'Person', name: 'Blaž Perić', url: new URL('/', Astro.site).href },
  mainEntityOfPage: canonical.href,
  inLanguage: 'en',
};
---

<BaseLayout title={`${post.title} — Blaž Perić`} description={post.description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Blaž Perić" />
    <meta property="article:published_time" content={`${post.date}T00:00:00Z`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={post.description} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  {post.slug === "flutter-precache" ? <PrecachePost /> : <BlogPost client:load />}
</BaseLayout>
