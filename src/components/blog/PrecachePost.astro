];
const seedExample = `// Created during preparation, not downloaded at startup.
final initialCategories = List.unmodifiable([
  VehicleCategory(id: 'tuk-tuk', name: 'Tuk Tuk'),
  VehicleCategory(id: 'van', name: 'Van'),
]);`;
---

<div class="pc-article">
